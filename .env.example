# Copiar a .env.local para desarrollo. En Vercel se cargan en Settings → Environment Variables.

# Turso (sin estas dos, en local se usa el archivo local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Clave para firmar sesiones: 32+ caracteres al azar (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Dirección de la app
BETTER_AUTH_URL=http://localhost:3000

# Opcional: fotos en Vercel Blob
BLOB_READ_WRITE_TOKEN=
